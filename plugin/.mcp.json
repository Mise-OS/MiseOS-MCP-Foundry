{
  "mcpServers": {
    "miseos-foundry": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/gateway.mjs"]
    },
    "miseos-developer-bot": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/developer-bot.mjs"],
      "env": {
        "OPENROUTER_MODEL": "openrouter/free",
        "OPENROUTER_APP_NAME": "MiseOS Free Developer Bot",
        "OPENROUTER_SITE_URL": "https://github.com/Mise-OS/MiseOS-MCP-Foundry"
      }
    }
  }
}
